# Auto-detect text files and perform LF normalization
* text=auto

# F# and .NET specific settings
*.fs text diff=fsharp linguist-language=F#
*.fsproj text
*.sln text eol=crlf

# Shell scripts should always have LF line endings
*.sh text eol=lf
*.cmd text eol=crlf

# Blazor / WebAssembly (Bolero) binary safety
*.wasm binary
*.dll binary
*.png binary

# GitHub Linguist Language Configuration
# Exclude build/project metadata while letting authored languages (F#, JS, CSS, HTML) detect naturally
*.fs text diff=fsharp linguist-language=F# linguist-detectable=true
*.fsx text diff=fsharp linguist-language=F# linguist-detectable=true
*.fsproj text linguist-detectable=false
*.xml linguist-detectable=false
*.props linguist-detectable=false
*.svg linguist-detectable=false
