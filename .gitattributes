# Auto-detect text files and perform LF normalization
* text=auto

# F# and .NET specific settings
*.fs text diff=fsharp linguist-language=F#
*.fsproj text
*.sln text eol=crlf

# Shell scripts should always have LF line endings
*.sh text eol=lf
*.cmd text eol=crlf

# Blazor / WebAssembly (Bolero) binary safety
*.wasm binary
*.dll binary
*.png binary

# GitHub Linguist Language Configuration
# Ensures GitHub identifies Hywe as a 100% F# project
*.fs text diff=fsharp linguist-language=F# linguist-detectable=true
*.fsproj text linguist-detectable=true

*.js linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
src/Hywe.Web/wwwroot/** linguist-detectable=false
