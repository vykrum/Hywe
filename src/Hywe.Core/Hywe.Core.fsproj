<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- NuGet Metadata -->
    <PackageId>Hywe.Core</PackageId>
    <Version>2026.11.23</Version>
    <Authors>Vikram Subbaiah</Authors>
    <Company>Hywe</Company>
    <Description>Deterministic spatial topology and integer lattice packing engine for the Hygrid Woven Ensemble (HYWE).</Description>
    <PackageTags>architecture;spatial-design;computational-design;topology;fsharp;hywe;hygrid;generative;geometry</PackageTags>
    <PackageProjectUrl>https://hywe.in</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vykrum/Hywe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/vykrum/Hywe/blob/main/RELEASE_NOTES.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Hexel.fs" />
    <Compile Include="Coxel.fs" />
    <Compile Include="Goxel.fs" />
    <Compile Include="Lexel.fs" />
    <Compile Include="Xyxel.fs" />
    <Compile Include="Nexel.fs" />
    <Compile Include="Zaxel.fs" />
  </ItemGroup>
</Project>
