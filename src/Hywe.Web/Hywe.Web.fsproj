<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Hywe.Core\Hywe.Core.fsproj" />
		<ProjectReference Include="..\Hywe.Tree\Hywe.Tree.fsproj" />
		<ProjectReference Include="..\Hywe.Site\Hywe.Site.fsproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Rendering Layer -->
		<Compile Include="Rendering/Graphics.fs" />
		<Compile Include="Rendering/Shaders.fs" />
		<Compile Include="Rendering/ThreeD.fs" />

		<!-- Core Panel Components -->
		<Compile Include="Panels/NodeActions.fs" />
		<Compile Include="Panels/NodeTree.fs" />

		<!-- State & Model Types -->
		<Compile Include="Common/ModelTypes.fs" />

		<!-- Reusable UI Components -->
		<Compile Include="Components/PageElements.fs" />
		<Compile Include="Components/PageHelp.fs" />

		<!-- Shared Domain & Infrastructure -->
		<Compile Include="Common/PageTreeFiltering.fs" />
		<Compile Include="Common/FileManager.fs" />

		<!-- Feature Panels -->
		<Compile Include="Panels/Boundary.fs" />
		<Compile Include="Panels/Analyze.fs" />
		<Compile Include="Panels/Report.fs" />
		<Compile Include="Panels/Layout.fs" />

		<!-- Utilities & Secondary Panels -->
		<Compile Include="Common/Cache.fs" />
		<Compile Include="Components/PageHelpers.fs" />
		<Compile Include="Panels/Teach.fs" />

		<!-- Application Composition & Shell -->
		<Compile Include="App/Overlays.fs" />
		<Compile Include="App/ModelHelpers.fs" />
		<Compile Include="Components/Shell.fs" />
		<Compile Include="App/AppState.fs" />
		<Compile Include="App/Benchmarks.fs" />
		<Compile Include="App/Main.fs" />
		<Compile Include="App/Startup.fs" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Bolero" Version="0.25.63" />
		<PackageReference Include="Bolero.Build" Version="0.25.63" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-preview.1.25120.3" />
	</ItemGroup>
</Project>
